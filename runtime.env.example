# Platform/provider credentials may be seeded here, or filled from the
# authenticated Core cockpit after the first bootstrap.
ERDAI_QQ_SECRET=

# A fresh install can leave Runtime Token and Model API Key empty. The
# authenticated cockpit then reports setup_required and accepts them under
# Integrations -> Credentials before the runtime is activated.

# 管理台凭据入口写入数据卷中的独立文件，并在覆盖前保留 managed-credentials.env.bak。
# 原始 runtime.env 仍是宿主启动配置，不会被管理台改写。
ERDAI_MANAGED_CREDENTIALS_FILE=/app/data/managed-credentials.env
ERDAI_UPDATE_STATUS_DIR=/opt/erdai-agent/update-status

# Human login (optional; token login remains available for automation).
ERDAI_ADMIN_USERNAME=
ERDAI_ADMIN_PASSWORD=
# Prefer a precomputed SHA-256 over plaintext when the host secret manager supports it.
ERDAI_ADMIN_PASSWORD_SHA256=

# Stable checks and authenticated requests use GitHub Releases. The host-side
# updater remains responsible for download verification, backup, health gate and rollback.
ERDAI_UPDATE_REPOSITORY=margetrp-hub/erdai-agent
ERDAI_UPDATE_API_BASE_URL=https://api.github.com

# Release bundles inject ERDAI_RELEASE_IMAGE and ERDAI_EMBEDDING_IMAGE from manifest.env.
# Do not hand-edit image tags on the VPS.

# Internal semantic provider credential. Keep this only on the VPS.
ERDAI_LOCAL_SEMANTIC_KEY=

# Add the environment-variable references selected in the channel editor.
# Examples:
# ERDAI_TELEGRAM_TOKEN=
# ERDAI_DISCORD_TOKEN=

# Optional production resource overrides. Defaults reserve memory for the OS and Docker on a 1.6-GiB VPS.
# Keep ERDAI_MEMORY_LIMIT + ERDAI_EMBEDDING_MEMORY_LIMIT <= 1024m.
# ERDAI_GOMAXPROCS=1
# ERDAI_GOMEMLIMIT=384MiB
# ERDAI_CPU_LIMIT=1.5
# ERDAI_MEMORY_LIMIT=512m
# ERDAI_MEMORY_SWAP_LIMIT=768m
# ERDAI_EMBEDDING_MEMORY_LIMIT=448m
# ERDAI_EMBEDDING_MEMORY_SWAP_LIMIT=640m
